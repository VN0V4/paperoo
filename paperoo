USER_AGENT = f"paperoo/{__version__}"

# flag -> minimum resolution
RESOLUTIONS = {
    "hd": "1280x720",
    "1080p": "1920x1080",
    "1440p": "2560x1440",
    "2k": "2560x1440",
    "4k": "3840x2160",
